[
  {
    "name": "launch_app",
    "label": "Launch Native App",
    "description": "Launch a native application and immediately return its observed UI state.",
    "promptSnippet": "Use to launch or focus a native macOS desktop application before interacting with it.",
    "promptGuidelines": [],
    "parameters": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Application name (e.g. Notes, Calculator, TextEdit, Finder)"
        },
        "bundleId": {
          "type": "string",
          "description": "Exact bundle id (e.g. com.apple.Notes)"
        },
        "createsNewApplicationInstance": {
          "type": "boolean",
          "description": "Whether to launch a new application instance"
        }
      }
    }
  },
  {
    "name": "find_roots",
    "label": "Find Roots",
    "description": "Find a bounded, ranked set of controllable UI roots with refs, geometry, and focus state.",
    "promptSnippet": "Find a target root before observe_ui when needed.",
    "promptGuidelines": [],
    "parameters": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "description": "Ranked app or title text",
          "maxLength": 256
        },
        "app": {
          "type": "string",
          "description": "Exact normalized app name",
          "maxLength": 256
        },
        "bundleId": {
          "type": "string",
          "description": "Exact bundle id"
        },
        "pid": {
          "type": "number",
          "description": "Exact process id"
        },
        "kind": {
          "anyOf": [
            {
              "type": "string",
              "const": "window"
            },
            {
              "type": "string",
              "const": "menu"
            },
            {
              "type": "string",
              "const": "sheet"
            },
            {
              "type": "string",
              "const": "popover"
            },
            {
              "type": "string",
              "const": "dialog"
            },
            {
              "type": "string",
              "const": "browser_page"
            }
          ],
          "description": "Exact root kind"
        }
      }
    }
  },
  {
    "name": "observe_ui",
    "label": "Observe UI",
    "description": "Capture the current/frontmost root or one exact @r root and return a bounded UI outline.",
    "promptSnippet": "Primary UI observation tool. Follow with search_ui, expand_ui, inspect_ui, or act_ui.",
    "promptGuidelines": [
      "Use mode=semantic to skip OCR and images, visual to force them, and fused for automatic selection.",
      "Use @e outline refs from observe_ui/search_ui for act_ui; pictureOnly refs are coordinate-only and blocked by UI-tree-only policy."
    ],
    "parameters": {
      "type": "object",
      "properties": {
        "root": {
          "type": "string",
          "description": "Exact @r ref issued by find_roots"
        },
        "mode": {
          "anyOf": [
            {
              "type": "string",
              "const": "semantic"
            },
            {
              "type": "string",
              "const": "visual"
            },
            {
              "type": "string",
              "const": "fused"
            }
          ],
          "description": "Observation mode, default fused"
        }
      }
    }
  },
  {
    "name": "search_ui",
    "label": "Search UI",
    "description": "Return a bounded, deterministically ranked search of the cached outline. At least one predicate is required.",
    "promptSnippet": "Find targets not shown in the compact observe_ui output; refine broad searches instead of paging matches.",
    "promptGuidelines": [],
    "parameters": {
      "type": "object",
      "required": [
        "stateId"
      ],
      "properties": {
        "text": {
          "type": "string",
          "description": "Human-readable text or label",
          "maxLength": 256
        },
        "role": {
          "type": "string",
          "description": "Exact normalized role, e.g. button",
          "maxLength": 128
        },
        "capability": {
          "type": "string",
          "description": "Exact capability, e.g. press",
          "maxLength": 128
        },
        "stateId": {
          "type": "string",
          "description": "Required state id owning every @e ref used by this operation"
        }
      }
    }
  },
  {
    "name": "expand_ui",
    "label": "Expand UI",
    "description": "Unfold bounded local outline context for one @e ref.",
    "promptSnippet": "Expand a specific ref instead of dumping unrelated UI.",
    "promptGuidelines": [],
    "parameters": {
      "type": "object",
      "required": [
        "ref",
        "stateId"
      ],
      "properties": {
        "ref": {
          "type": "string"
        },
        "depth": {
          "type": "number",
          "minimum": 1,
          "maximum": 8,
          "description": "Subtree depth, default 3"
        },
        "stateId": {
          "type": "string",
          "description": "Required state id owning every @e ref used by this operation"
        }
      }
    }
  },
  {
    "name": "inspect_ui",
    "label": "Inspect UI",
    "description": "Inspect one exact outline ref with fields, geometry, capabilities, and annotations.",
    "promptSnippet": "Use when a target's evidence or provenance matters.",
    "promptGuidelines": [],
    "parameters": {
      "type": "object",
      "required": [
        "ref",
        "stateId"
      ],
      "properties": {
        "ref": {
          "type": "string"
        },
        "stateId": {
          "type": "string",
          "description": "Required state id owning every @e ref used by this operation"
        }
      }
    }
  },
  {
    "name": "act_ui",
    "label": "Act",
    "description": "Perform one or more precisely targeted checked actions and return the successor state.",
    "promptSnippet": "Pass dependent click/type steps together and use expect for observable completion.",
    "promptGuidelines": [
      "After clicking an editable region, omit ref from typeText/keypress so input follows the established focus."
    ],
    "parameters": {
      "type": "object",
      "required": [
        "stateId",
        "actions"
      ],
      "properties": {
        "stateId": {
          "type": "string",
          "description": "Required state id owning every @e ref used by this operation"
        },
        "expect": {
          "type": "object",
          "properties": {
            "ref": {
              "type": "string",
              "description": "Specific @e ref to test",
              "maxLength": 128
            },
            "scopeRef": {
              "type": "string",
              "description": "Restrict matching to this @e subtree",
              "maxLength": 128
            },
            "text": {
              "type": "string",
              "description": "Text that must match",
              "maxLength": 512
            },
            "role": {
              "type": "string",
              "description": "Exact normalized role",
              "maxLength": 128
            },
            "value": {
              "type": "string",
              "description": "Exact normalized value; normally pair with ref"
            },
            "until": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "present"
                },
                {
                  "type": "string",
                  "const": "absent"
                }
              ],
              "description": "Desired condition, default present"
            },
            "timeoutMs": {
              "type": "number",
              "description": "Maximum wait, default 10000ms",
              "minimum": 100,
              "maximum": 60000
            }
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "action",
                  "ref"
                ],
                "properties": {
                  "action": {
                    "type": "string",
                    "const": "press"
                  },
                  "ref": {
                    "type": "string",
                    "description": "Actionable outline ref"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "action",
                  "ref"
                ],
                "properties": {
                  "action": {
                    "type": "string",
                    "const": "click"
                  },
                  "ref": {
                    "type": "string"
                  },
                  "button": {
                    "anyOf": [
                      {
                        "type": "string",
                        "const": "left"
                      },
                      {
                        "type": "string",
                        "const": "right"
                      },
                      {
                        "type": "string",
                        "const": "middle"
                      }
                    ]
                  },
                  "clickCount": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 3
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "action",
                  "x",
                  "y"
                ],
                "properties": {
                  "action": {
                    "type": "string",
                    "const": "click"
                  },
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "button": {
                    "anyOf": [
                      {
                        "type": "string",
                        "const": "left"
                      },
                      {
                        "type": "string",
                        "const": "right"
                      },
                      {
                        "type": "string",
                        "const": "middle"
                      }
                    ]
                  },
                  "clickCount": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 3
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "action",
                  "ref",
                  "text"
                ],
                "properties": {
                  "action": {
                    "type": "string",
                    "const": "setText"
                  },
                  "ref": {
                    "type": "string",
                    "description": "Editable outline ref"
                  },
                  "text": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "action",
                  "text"
                ],
                "properties": {
                  "action": {
                    "type": "string",
                    "const": "typeText"
                  },
                  "ref": {
                    "type": "string",
                    "description": "Omit after a click to type into the focus established by that click"
                  },
                  "text": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "action",
                  "keys"
                ],
                "properties": {
                  "action": {
                    "type": "string",
                    "const": "keypress"
                  },
                  "ref": {
                    "type": "string",
                    "description": "Omit to send keys to the focused control"
                  },
                  "keys": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "action"
                ],
                "properties": {
                  "action": {
                    "type": "string",
                    "const": "scroll"
                  },
                  "ref": {
                    "type": "string"
                  },
                  "scrollX": {
                    "type": "number"
                  },
                  "scrollY": {
                    "type": "number"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "action",
                  "path"
                ],
                "properties": {
                  "action": {
                    "type": "string",
                    "const": "drag"
                  },
                  "path": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "x",
                        "y"
                      ],
                      "properties": {
                        "x": {
                          "type": "number"
                        },
                        "y": {
                          "type": "number"
                        }
                      }
                    },
                    "minItems": 2
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "action",
                  "x",
                  "y"
                ],
                "properties": {
                  "action": {
                    "type": "string",
                    "const": "moveMouse"
                  },
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                }
              }
            ]
          },
          "minItems": 1,
          "maxItems": 20
        }
      }
    }
  },
  {
    "name": "read_text",
    "label": "Read Text",
    "description": "Read a fixed-size page from an @e UI ref or immutable @o truncated-output ref.",
    "promptSnippet": "Use @e with its stateId; @o continuation refs don't need stateId.",
    "promptGuidelines": [],
    "parameters": {
      "type": "object",
      "required": [
        "ref"
      ],
      "properties": {
        "ref": {
          "type": "string"
        },
        "offset": {
          "type": "number",
          "minimum": 0
        },
        "stateId": {
          "type": "string",
          "description": "Required state id owning every @e ref used by this operation"
        }
      }
    }
  },
  {
    "name": "wait_for",
    "label": "Wait For",
    "description": "Wait for one scoped UI condition and return the successor state.",
    "promptSnippet": "Use after asynchronous UI changes instead of polling observe_ui.",
    "promptGuidelines": [],
    "parameters": {
      "type": "object",
      "required": [
        "stateId"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "description": "Specific @e ref to test",
          "maxLength": 128
        },
        "scopeRef": {
          "type": "string",
          "description": "Restrict matching to this @e subtree",
          "maxLength": 128
        },
        "text": {
          "type": "string",
          "description": "Text that must match",
          "maxLength": 512
        },
        "role": {
          "type": "string",
          "description": "Exact normalized role",
          "maxLength": 128
        },
        "value": {
          "type": "string",
          "description": "Exact normalized value; normally pair with ref"
        },
        "until": {
          "anyOf": [
            {
              "type": "string",
              "const": "present"
            },
            {
              "type": "string",
              "const": "absent"
            }
          ],
          "description": "Desired condition, default present"
        },
        "timeoutMs": {
          "type": "number",
          "description": "Maximum wait, default 10000ms",
          "minimum": 100,
          "maximum": 60000
        },
        "stateId": {
          "type": "string",
          "description": "Required state id owning every @e ref used by this operation"
        }
      }
    }
  },
  {
    "name": "launch_browser",
    "label": "Launch Browser Context",
    "description": "Launch the configured Pi-managed CDP browser and return an observed browser-page state.",
    "promptSnippet": "Use for browser work that needs a managed CDP context.",
    "promptGuidelines": [
      "Prefer curl through bash when the page is directly fetchable."
    ],
    "parameters": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "maxLength": 8192
        }
      }
    }
  },
  {
    "name": "navigate_browser",
    "label": "Navigate Browser",
    "description": "Navigate an observed CDP browser-page state to an HTTP(S) URL.",
    "promptSnippet": "Native browser windows use act_ui; this tool is CDP-only.",
    "promptGuidelines": [],
    "parameters": {
      "type": "object",
      "required": [
        "url",
        "stateId"
      ],
      "properties": {
        "url": {
          "type": "string",
          "maxLength": 8192
        },
        "stateId": {
          "type": "string",
          "description": "Required state id owning every @e ref used by this operation"
        }
      }
    }
  },
  {
    "name": "evaluate_browser",
    "label": "Evaluate Browser",
    "description": "Evaluate targeted JavaScript in a CDP browser-page state; returned output is strictly bounded.",
    "promptSnippet": "Prefer observe/search/read; return selected fields, aggregates, or bounded slices.",
    "promptGuidelines": [],
    "parameters": {
      "type": "object",
      "required": [
        "stateId",
        "expression"
      ],
      "properties": {
        "stateId": {
          "type": "string",
          "description": "Required state id owning every @e ref used by this operation"
        },
        "expression": {
          "type": "string",
          "maxLength": 65536
        }
      }
    }
  }
]
