{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main", "pet"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "dialog:default",
    "notification:default",
    "global-shortcut:default",
    "core:webview:allow-set-webview-zoom",
    "core:window:allow-start-dragging"
  ]
}
