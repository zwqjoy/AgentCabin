{
  "name": "agentcabin",
  "version": "0.2.1",
  "description": "Local-first desktop app for AI-assisted vibe coding",
  "type": "module",
  "license": "Apache-2.0",
  "main": "electron/dist/main.cjs",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node scripts/electron-dev.mjs",
    "dev:web": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "node scripts/electron-dev.mjs",
    "build:electron": "node scripts/build-electron.mjs",
    "build:core:release": "cargo build --release --bin AgentCabin --manifest-path src-tauri/Cargo.toml",
    "build:app": "npm run build && npm run build:electron && npm run build:core:release",
    "electron:start": "npm run build && npm run build:electron && electron .",
    "electron:package": "node scripts/package-electron.mjs",
    "electron:package:dir": "node scripts/package-electron.mjs --dir",
    "electron:package:mac": "node scripts/package-electron.mjs --mac",
    "prepare:runtimes": "node scripts/prepare-runtimes.mjs",
    "verify:runtimes": "node scripts/verify-runtime-closure.mjs",
    "smoke:packaged-runtimes": "node scripts/smoke-packaged-runtimes.mjs",
    "electron:typecheck": "tsc -p electron/tsconfig.json",
    "package": "node scripts/package-electron.mjs --mac",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "rust:check": "npm run rust:fmt && npm run rust:clippy",
    "test:work:golden": "cargo test --manifest-path src-tauri/Cargo.toml work::workbench::golden --lib -- --nocapture",
    "test:work:smoke": "node scripts/run-work-smoke.mjs",
    "eval:computer-use": "node --test src-tauri/src/work/eval/eval_harness.test.mjs",
    "eval:computer-use:live": "node src-tauri/src/work/eval/run_live.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "pet:transparency-check": "node scripts/pet-transparency-check.mjs",
    "doc:check": "node scripts/doc-check.mjs",
    "grok:capture-initialize": "node scripts/capture-grok-acp-initialize.mjs",
    "grok:probe-p5": "node scripts/probe-grok-acp-p5.mjs",
    "fix": "npm run lint:fix && npm run format && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "verify": "npm run lint && npm run format:check && npm run check && npm run i18n:check && npm run pet:transparency-check && npm run test && npm run build && npm run rust:check",
    "release": "node scripts/release.mjs",
    "prepare:pi-extensions": "node scripts/prepare-pi-extensions.mjs",
    "prepare:agentcabin-computer-use": "node scripts/prepare-agentcabin-computer-use.mjs",
    "eval:computer-use:host": "node src-tauri/src/work/eval/run_live.mjs --host",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.16.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/diff": "^7.0.2",
    "@types/node": "^25.3.0",
    "@types/turndown": "^5.0.6",
    "autoprefixer": "^10.4.20",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.15.0",
    "globals": "^17.3.0",
    "postcss": "^8.5.1",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.4.1",
    "svelte": "^5.53.3",
    "svelte-check": "^4.3.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.55.0",
    "vite": "^6.1.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/legacy-modes": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.1",
    "diff": "^8.0.3",
    "dompurify": "^3.2.4",
    "echarts": "^6.1.0",
    "exceljs": "^4.4.0",
    "highlight.js": "^11.11.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.11.0",
    "marked": "^15.0.0",
    "mermaid": "^11.16.1",
    "pdfjs-dist": "^6.2.108",
    "turndown": "^7.2.2"
  },
  "browserslist": [
    "safari >= 16.1",
    "chrome >= 105",
    "edge >= 105"
  ],
  "packageManager": "npm@10.9.8"
}
